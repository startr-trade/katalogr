{
  "$defs": {
    "Confidence": {
      "description": "Schema-only mirror of [`katalogr_model::Confidence`].",
      "enum": [
        "Extracted",
        "Inferred",
        "Declared"
      ],
      "type": "string"
    },
    "Explain": {
      "properties": {
        "doc": {
          "type": [
            "string",
            "null"
          ]
        },
        "incoming": {
          "items": {
            "$ref": "#/$defs/LinkBrief"
          },
          "type": "array"
        },
        "incoming_total": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "items": {
          "description": "Rationale targets (board items, documents, commits), sorted.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "outgoing": {
          "description": "At most `per_side` links, sorted by kind then name.",
          "items": {
            "$ref": "#/$defs/LinkBrief"
          },
          "type": "array"
        },
        "outgoing_total": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "signature": {
          "type": [
            "string",
            "null"
          ]
        },
        "symbol": {
          "$ref": "#/$defs/SymbolHit"
        }
      },
      "required": [
        "symbol",
        "outgoing",
        "outgoing_total",
        "incoming",
        "incoming_total",
        "items"
      ],
      "type": "object"
    },
    "LinkBrief": {
      "description": "One link of a symbol, seen from that symbol.",
      "properties": {
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "kind": {
          "type": "string"
        },
        "origin": {
          "description": "The profile rule (`profile:<name>#<rule id>`) that produced the link, when one did.",
          "type": [
            "string",
            "null"
          ]
        },
        "other": {
          "description": "Canonical name of the other end (the hex id when it is not a known node).",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "other",
        "confidence"
      ],
      "type": "object"
    },
    "Span": {
      "description": "Schema-only mirror of [`katalogr_model::Span`].",
      "properties": {
        "end_col": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "end_line": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "start_col": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "start_line": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "start_line",
        "start_col",
        "end_line",
        "end_col"
      ],
      "type": "object"
    },
    "SymbolHit": {
      "properties": {
        "kind": {
          "type": "string"
        },
        "name": {
          "description": "Canonical name.",
          "type": "string"
        },
        "path": {
          "description": "Repository-relative path.",
          "type": "string"
        },
        "span": {
          "$ref": "#/$defs/Span"
        }
      },
      "required": [
        "name",
        "kind",
        "path",
        "span"
      ],
      "type": "object"
    },
    "Truncation": {
      "properties": {
        "budget": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "omitted": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "shown": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "shown",
        "omitted",
        "budget"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "What `--json` prints.",
  "properties": {
    "next": {
      "description": "Suggested follow-up commands, at most three.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "pending": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "result": {
      "$ref": "#/$defs/Explain"
    },
    "schema": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "stale": {
      "type": "boolean"
    },
    "truncated": {
      "anyOf": [
        {
          "$ref": "#/$defs/Truncation"
        },
        {
          "type": "null"
        }
      ]
    },
    "watermark": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema",
    "watermark",
    "pending",
    "stale",
    "result"
  ],
  "title": "Envelope",
  "type": "object"
}
