{
  "$defs": {
    "DanglingRef": {
      "description": "A reference that names something no artifact exports.",
      "properties": {
        "from": {
          "$ref": "#/$defs/SymbolHit",
          "description": "The symbol (or artifact) the reference starts at."
        },
        "kind": {
          "description": "Link kind.",
          "type": "string"
        },
        "wanted": {
          "description": "The export keys that were looked for, `namespace:key`, most specific first.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "from",
        "kind",
        "wanted"
      ],
      "type": "object"
    },
    "Span": {
      "description": "Schema-only mirror of [`katalogr_model::Span`].",
      "properties": {
        "end_col": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "end_line": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "start_col": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "start_line": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "start_line",
        "start_col",
        "end_line",
        "end_col"
      ],
      "type": "object"
    },
    "SymbolHit": {
      "properties": {
        "kind": {
          "type": "string"
        },
        "name": {
          "description": "Canonical name.",
          "type": "string"
        },
        "path": {
          "description": "Repository-relative path.",
          "type": "string"
        },
        "span": {
          "$ref": "#/$defs/Span"
        }
      },
      "required": [
        "name",
        "kind",
        "path",
        "span"
      ],
      "type": "object"
    },
    "Truncation": {
      "properties": {
        "budget": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "omitted": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "shown": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "shown",
        "omitted",
        "budget"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "What `--json` prints.",
  "properties": {
    "pending": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "result": {
      "items": {
        "$ref": "#/$defs/DanglingRef"
      },
      "type": "array"
    },
    "schema": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "stale": {
      "type": "boolean"
    },
    "truncated": {
      "anyOf": [
        {
          "$ref": "#/$defs/Truncation"
        },
        {
          "type": "null"
        }
      ]
    },
    "watermark": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema",
    "watermark",
    "pending",
    "stale",
    "result"
  ],
  "title": "Envelope",
  "type": "object"
}
