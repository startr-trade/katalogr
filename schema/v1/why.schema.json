{
  "$defs": {
    "CommitHit": {
      "description": "A commit that introduced the line and the board items its trailers name.",
      "properties": {
        "items": {
          "description": "Canonical names of the items and requirements the commit's trailers name.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "sha": {
          "description": "Full commit id.",
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "sha",
        "summary",
        "items"
      ],
      "type": "object"
    },
    "Note": {
      "description": "A rationale marker (`NOTE:`, `WHY:`, `RATIONALE:`) recorded on the symbol.",
      "properties": {
        "line": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "marker": {
          "description": "`NOTE`, `WHY` or `RATIONALE`.",
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "marker",
        "line",
        "text"
      ],
      "type": "object"
    },
    "Partial": {
      "description": "The answer was cut by a cap: more items exist (or may exist) than are shown.",
      "properties": {
        "at": {
          "description": "The cap's value: N in \"capped at N\" (items, hops, or tokens for `budget`).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "cap": {
          "description": "Which cap: one of [`cap`]'s names.",
          "type": "string"
        },
        "note": {
          "description": "Always [`PARTIAL_NOTE`].",
          "type": "string"
        },
        "shown": {
          "description": "Items shown.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "description": "Items there were before the cap, when known.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "cap",
        "at",
        "shown",
        "note"
      ],
      "type": "object"
    },
    "RationaleLink": {
      "properties": {
        "kind": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "target": {
          "description": "Canonical name, or the hex id when the target is not a known symbol.",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "target",
        "label"
      ],
      "type": "object"
    },
    "Span": {
      "description": "Schema-only mirror of [`katalogr_model::Span`].",
      "properties": {
        "end_col": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "end_line": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "start_col": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "start_line": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "start_line",
        "start_col",
        "end_line",
        "end_col"
      ],
      "type": "object"
    },
    "SymbolHit": {
      "properties": {
        "kind": {
          "type": "string"
        },
        "name": {
          "description": "Canonical name.",
          "type": "string"
        },
        "path": {
          "description": "Repository-relative path.",
          "type": "string"
        },
        "span": {
          "$ref": "#/$defs/Span"
        }
      },
      "required": [
        "name",
        "kind",
        "path",
        "span"
      ],
      "type": "object"
    },
    "Truncation": {
      "properties": {
        "budget": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "omitted": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "shown": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "shown",
        "omitted",
        "budget"
      ],
      "type": "object"
    },
    "WhyResult": {
      "properties": {
        "commits": {
          "description": "The commit that introduced the line, when it carries item trailers.",
          "items": {
            "$ref": "#/$defs/CommitHit"
          },
          "type": "array"
        },
        "goals": {
          "description": "The goals served by the items and requirements reached (kind `serves`).",
          "items": {
            "$ref": "#/$defs/RationaleLink"
          },
          "type": "array"
        },
        "note": {
          "description": "Why part of the answer is missing, for example that blame was unavailable.",
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "description": "The comment markers recorded on the symbol, in line order.",
          "items": {
            "$ref": "#/$defs/Note"
          },
          "type": "array"
        },
        "rationale": {
          "items": {
            "$ref": "#/$defs/RationaleLink"
          },
          "type": "array"
        },
        "symbol": {
          "$ref": "#/$defs/SymbolHit"
        }
      },
      "required": [
        "symbol",
        "rationale",
        "goals",
        "commits"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "What `--json` prints.",
  "properties": {
    "next": {
      "description": "Suggested follow-up commands, at most three.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "partial": {
      "description": "Present when a cap or budget cut the answer; one entry per cap that cut it.",
      "items": {
        "$ref": "#/$defs/Partial"
      },
      "type": "array"
    },
    "pending": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "result": {
      "$ref": "#/$defs/WhyResult"
    },
    "schema": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "stale": {
      "type": "boolean"
    },
    "truncated": {
      "anyOf": [
        {
          "$ref": "#/$defs/Truncation"
        },
        {
          "type": "null"
        }
      ]
    },
    "watermark": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema",
    "watermark",
    "pending",
    "stale",
    "result"
  ],
  "title": "Envelope",
  "type": "object"
}
