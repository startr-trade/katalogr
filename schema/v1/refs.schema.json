{
  "$defs": {
    "Confidence": {
      "description": "Schema-only mirror of [`katalogr_model::Confidence`].",
      "enum": [
        "Extracted",
        "Inferred",
        "Declared"
      ],
      "type": "string"
    },
    "Partial": {
      "description": "The answer was cut by a cap: more items exist (or may exist) than are shown.",
      "properties": {
        "at": {
          "description": "The cap's value: N in \"capped at N\" (items, hops, or tokens for `budget`).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "cap": {
          "description": "Which cap: one of [`cap`]'s names.",
          "type": "string"
        },
        "note": {
          "description": "Always [`PARTIAL_NOTE`].",
          "type": "string"
        },
        "shown": {
          "description": "Items shown.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "description": "Items there were before the cap, when known.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "cap",
        "at",
        "shown",
        "note"
      ],
      "type": "object"
    },
    "RefHit": {
      "properties": {
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "from": {
          "$ref": "#/$defs/SymbolHit"
        },
        "kind": {
          "description": "Link kind.",
          "type": "string"
        },
        "via": {
          "description": "Re-export chain, nearest the target first; empty for a direct reference.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "from",
        "kind",
        "confidence",
        "via"
      ],
      "type": "object"
    },
    "Span": {
      "description": "Schema-only mirror of [`katalogr_model::Span`].",
      "properties": {
        "end_col": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "end_line": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "start_col": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "start_line": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "start_line",
        "start_col",
        "end_line",
        "end_col"
      ],
      "type": "object"
    },
    "SymbolHit": {
      "properties": {
        "kind": {
          "type": "string"
        },
        "name": {
          "description": "Canonical name.",
          "type": "string"
        },
        "path": {
          "description": "Repository-relative path.",
          "type": "string"
        },
        "span": {
          "$ref": "#/$defs/Span"
        }
      },
      "required": [
        "name",
        "kind",
        "path",
        "span"
      ],
      "type": "object"
    },
    "Truncation": {
      "properties": {
        "budget": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "omitted": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "shown": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "shown",
        "omitted",
        "budget"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "What `--json` prints.",
  "properties": {
    "next": {
      "description": "Suggested follow-up commands, at most three.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "partial": {
      "description": "Present when a cap or budget cut the answer; one entry per cap that cut it.",
      "items": {
        "$ref": "#/$defs/Partial"
      },
      "type": "array"
    },
    "pending": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "result": {
      "items": {
        "$ref": "#/$defs/RefHit"
      },
      "type": "array"
    },
    "schema": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "stale": {
      "type": "boolean"
    },
    "truncated": {
      "anyOf": [
        {
          "$ref": "#/$defs/Truncation"
        },
        {
          "type": "null"
        }
      ]
    },
    "watermark": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema",
    "watermark",
    "pending",
    "stale",
    "result"
  ],
  "title": "Envelope",
  "type": "object"
}
