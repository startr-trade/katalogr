{
  "$defs": {
    "Confidence": {
      "description": "Schema-only mirror of [`katalogr_model::Confidence`].",
      "enum": [
        "Extracted",
        "Inferred",
        "Declared"
      ],
      "type": "string"
    },
    "ExpandedTerm": {
      "properties": {
        "postings": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "term": {
          "type": "string"
        }
      },
      "required": [
        "term",
        "postings"
      ],
      "type": "object"
    },
    "Fold": {
      "description": "Hits of `refs` or `callers` folded into one summary because they reach their node only\nthrough an export key with `FOLD_FROM` or more targets (FEAT-077). `--expand` lists them.",
      "properties": {
        "at": {
          "description": "The number of `result` entries that come before this fold in today's order.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "depth": {
          "description": "`callers`: the depth of the folded callers.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "first": {
          "description": "The first folded hits (referrer or caller), in today's order.",
          "items": {
            "$ref": "#/$defs/SymbolHit"
          },
          "type": "array"
        },
        "hits": {
          "description": "Hits folded.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "key": {
          "description": "The export key, `namespace:key`.",
          "type": "string"
        },
        "kind": {
          "description": "Link kind of the folded hits (`calls` for callers).",
          "type": "string"
        },
        "targets": {
          "description": "The key's current target count.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "via": {
          "description": "`refs`: the re-export chain of the folded hits, nearest the target first.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "key",
        "kind",
        "targets",
        "hits",
        "first",
        "at"
      ],
      "type": "object"
    },
    "FoldTrace": {
      "description": "One fold of a `refs` answer (FEAT-077).",
      "properties": {
        "at": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "hits": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "key": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "targets": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "key",
        "kind",
        "targets",
        "hits",
        "at"
      ],
      "type": "object"
    },
    "ImpactContract": {
      "properties": {
        "consumers": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "contract": {
          "description": "Canonical name.",
          "type": "string"
        },
        "open": {
          "description": "`no-provider` or `no-consumer` when impact may continue outside this project.",
          "type": [
            "string",
            "null"
          ]
        },
        "providers": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "contract",
        "providers",
        "consumers"
      ],
      "type": "object"
    },
    "LineageField": {
      "properties": {
        "copies": {
          "description": "The matching field in each other copy of the subject's contract, by name, sorted by name.",
          "items": {
            "$ref": "#/$defs/LineageFieldCopy"
          },
          "type": "array"
        },
        "depth": {
          "description": "1 for a direct member.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "field_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "many": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "mapped_by": {
          "description": "Symbols with a link into this field, kind not skipped, up to `per_group`, sorted by name.",
          "items": {
            "$ref": "#/$defs/LineageMapping"
          },
          "type": "array"
        },
        "mapped_total": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "node": {
          "$ref": "#/$defs/SymbolHit"
        },
        "required": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "node",
        "depth",
        "mapped_by",
        "mapped_total",
        "copies"
      ],
      "type": "object"
    },
    "LineageFieldCopy": {
      "properties": {
        "by": {
          "description": "`name` or `normalised-name`. Always Inferred.",
          "type": "string"
        },
        "node": {
          "$ref": "#/$defs/SymbolHit"
        }
      },
      "required": [
        "node",
        "by"
      ],
      "type": "object"
    },
    "LineageGroup": {
      "properties": {
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "hits": {
          "items": {
            "$ref": "#/$defs/LineageHit"
          },
          "type": "array"
        },
        "kind": {
          "description": "Link kind or role that reached the hit.",
          "type": "string"
        },
        "node_kind": {
          "type": "string"
        },
        "total": {
          "description": "Hits in this group before `per_group`.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "node_kind",
        "confidence",
        "total",
        "hits"
      ],
      "type": "object"
    },
    "LineageHit": {
      "properties": {
        "chain": {
          "description": "Nodes between the hit and the subject, hit side first, contracts excluded.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "depth": {
          "description": "Contract hops from the subject.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "holder": {
          "description": "The nearest ancestor by `contains` that binds a contract, when it isn't `node`.",
          "type": [
            "string",
            "null"
          ]
        },
        "node": {
          "$ref": "#/$defs/SymbolHit"
        },
        "role": {
          "description": "`test` for a test, as `role_of` says. Code groups only.",
          "type": [
            "string",
            "null"
          ]
        },
        "via": {
          "description": "The contract it was reached through.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "node",
        "depth",
        "chain"
      ],
      "type": "object"
    },
    "LineageMapping": {
      "properties": {
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "facts": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "String-valued facts of `node` whose key starts `wire_`, sorted. Empty for most.",
          "type": "object"
        },
        "kind": {
          "type": "string"
        },
        "node": {
          "$ref": "#/$defs/SymbolHit"
        }
      },
      "required": [
        "node",
        "kind",
        "confidence",
        "facts"
      ],
      "type": "object"
    },
    "LineageRelated": {
      "properties": {
        "node": {
          "$ref": "#/$defs/SymbolHit"
        },
        "relation": {
          "description": "`uses`, `used-by`, `extends` or `extended-by`.",
          "type": "string"
        },
        "through_field": {
          "description": "The field that carries the link, when one does.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "relation",
        "node"
      ],
      "type": "object"
    },
    "LineageReport": {
      "properties": {
        "bindings": {
          "description": "Non-code hits, sorted by depth, confidence (strongest first), kind, node kind.",
          "items": {
            "$ref": "#/$defs/LineageGroup"
          },
          "type": "array"
        },
        "boundaries": {
          "description": "Boundary codes, sorted.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "code": {
          "description": "Code hits, in the same order.",
          "items": {
            "$ref": "#/$defs/LineageGroup"
          },
          "type": "array"
        },
        "contracts": {
          "description": "Each contract reached, with counts and `open`. Sorted by name.",
          "items": {
            "$ref": "#/$defs/ImpactContract"
          },
          "type": "array"
        },
        "declared_in": {
          "description": "Sorted by name.",
          "items": {
            "$ref": "#/$defs/SymbolHit"
          },
          "type": "array"
        },
        "fields": {
          "description": "Depth first, in name order. Of the first declarer by name; other copies pair into `copies`.",
          "items": {
            "$ref": "#/$defs/LineageField"
          },
          "type": "array"
        },
        "owner": {
          "anyOf": [
            {
              "$ref": "#/$defs/SymbolHit"
            },
            {
              "type": "null"
            }
          ],
          "description": "The enclosing type, when the subject is a field."
        },
        "partial": {
          "items": {
            "$ref": "#/$defs/Partial"
          },
          "type": "array"
        },
        "projects": {
          "description": "Set by the facade.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "related": {
          "description": "Sorted by relation, then name.",
          "items": {
            "$ref": "#/$defs/LineageRelated"
          },
          "type": "array"
        },
        "repos": {
          "description": "The repos of the subject and hits, sorted.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "subject": {
          "$ref": "#/$defs/SymbolHit"
        },
        "subject_contracts": {
          "description": "Canonical names of the contracts the subject and its owner bind, sorted.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "total": {
          "description": "All hits before the limit; absent when the walk stopped early.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "unpaired_fields": {
          "description": "Fields of other copies that paired with none, sorted by name.",
          "items": {
            "$ref": "#/$defs/SymbolHit"
          },
          "type": "array"
        }
      },
      "required": [
        "subject",
        "subject_contracts",
        "declared_in",
        "fields",
        "unpaired_fields",
        "related",
        "bindings",
        "code",
        "contracts",
        "boundaries",
        "repos",
        "projects",
        "partial"
      ],
      "type": "object"
    },
    "PackEntry": {
      "properties": {
        "index": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "kept": {
          "type": "boolean"
        },
        "reason": {
          "description": "Set by context packs (FEAT-038).",
          "type": [
            "string",
            "null"
          ]
        },
        "tier": {
          "description": "Set by context packs (FEAT-038).",
          "type": [
            "string",
            "null"
          ]
        },
        "tokens": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "index",
        "tokens",
        "kept"
      ],
      "type": "object"
    },
    "PackTrace": {
      "properties": {
        "budget": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "considered": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "entries": {
          "description": "The first `DIAG_PACK` kept entries, plus the first omitted one.",
          "items": {
            "$ref": "#/$defs/PackEntry"
          },
          "type": "array"
        },
        "estimator": {
          "type": "string"
        },
        "first_omitted_tokens": {
          "description": "What the first omitted entry would have cost.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "kept": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "omitted": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "used_tokens": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "budget",
        "estimator",
        "considered",
        "kept",
        "omitted",
        "used_tokens",
        "entries"
      ],
      "type": "object"
    },
    "PartTrace": {
      "properties": {
        "contribution": {
          "description": "`factor * idf * t / (k1 + t)` (6 decimals).",
          "format": "double",
          "type": "number"
        },
        "factor": {
          "description": "1.0 for an exact term, the prefix factor for a prefix term.",
          "format": "double",
          "type": "number"
        },
        "t": {
          "description": "Field-weighted, length-normalised frequency (6 decimals).",
          "format": "double",
          "type": "number"
        },
        "term": {
          "description": "The indexed term that gave the best value.",
          "type": "string"
        },
        "token": {
          "type": "string"
        },
        "via": {
          "description": "`exact` or `prefix`.",
          "type": "string"
        }
      },
      "required": [
        "token",
        "via",
        "term",
        "t",
        "factor",
        "contribution"
      ],
      "type": "object"
    },
    "Partial": {
      "description": "The answer was cut by a cap: more items exist (or may exist) than are shown.",
      "properties": {
        "at": {
          "description": "The cap's value: N in \"capped at N\" (items, hops, or tokens for `budget`).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "cap": {
          "description": "Which cap: one of [`cap`]'s names.",
          "type": "string"
        },
        "note": {
          "description": "Always [`PARTIAL_NOTE`].",
          "type": "string"
        },
        "shown": {
          "description": "Items shown.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "description": "Items there were before the cap, when known.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "cap",
        "at",
        "shown",
        "note"
      ],
      "type": "object"
    },
    "PositionRef": {
      "description": "One repo's position. Serialises as `{\"repo\",\"commit\",\"dirty\"}`, absent parts as `null`.",
      "properties": {
        "commit": {
          "description": "40 lower-case hex, or `None` for a directory with no commit.",
          "type": [
            "string",
            "null"
          ]
        },
        "dirty": {
          "description": "64 lower-case hex, or `None` when the checkout is clean.",
          "type": [
            "string",
            "null"
          ]
        },
        "repo": {
          "type": "string"
        }
      },
      "required": [
        "repo"
      ],
      "type": "object"
    },
    "PrefixTrace": {
      "properties": {
        "attempted": {
          "description": "The token has enough characters to be expanded.",
          "type": "boolean"
        },
        "cap_hit": {
          "description": "The expansion cap was reached.",
          "type": "boolean"
        },
        "expanded": {
          "description": "Terms the expansion returned.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "factor": {
          "format": "double",
          "type": "number"
        },
        "terms": {
          "description": "At most `DIAG_TERMS`, in selection order.",
          "items": {
            "$ref": "#/$defs/ExpandedTerm"
          },
          "type": "array"
        }
      },
      "required": [
        "attempted",
        "expanded",
        "cap_hit",
        "factor",
        "terms"
      ],
      "type": "object"
    },
    "RankSource": {
      "properties": {
        "damping": {
          "format": "double",
          "type": "number"
        },
        "iterations": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "rank_watermark": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "source": {
          "description": "`cached` or `live`.",
          "type": "string"
        },
        "watermark": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "source",
        "watermark",
        "damping",
        "iterations"
      ],
      "type": "object"
    },
    "RankTrace": {
      "properties": {
        "parts": {
          "description": "One per query token that contributed, in query order.",
          "items": {
            "$ref": "#/$defs/PartTrace"
          },
          "type": "array"
        },
        "position": {
          "description": "1-based.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "score": {
          "description": "As printed in the answer.",
          "format": "double",
          "type": "number"
        },
        "symbol": {
          "description": "Canonical name.",
          "type": "string"
        },
        "tied_with_next": {
          "description": "Same score as the next hit, so the name order decided.",
          "type": "boolean"
        }
      },
      "required": [
        "position",
        "symbol",
        "score",
        "parts",
        "tied_with_next"
      ],
      "type": "object"
    },
    "RoutingTrace": {
      "properties": {
        "after_collapse": {
          "description": "After re-export and impl collapsing.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "candidates": {
          "description": "Symbols the winning tier matched before alias collapsing.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "command": {
          "description": "`search`, `refs` or `map`.",
          "type": "string"
        },
        "dropped": {
          "description": "`search`: words of the input that produced no token.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "input": {
          "description": "The user's text (not a path).",
          "type": "string"
        },
        "kind": {
          "description": "`tokens`, `name` or `none`.",
          "type": "string"
        },
        "tier": {
          "description": "`refs`: `contract`, `canonical`, `plain` or `plain_ci`.",
          "type": [
            "string",
            "null"
          ]
        },
        "tokens": {
          "description": "`search`: the query tokens, deduplicated, in order.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "command",
        "input",
        "kind",
        "tokens",
        "dropped",
        "candidates",
        "after_collapse"
      ],
      "type": "object"
    },
    "Span": {
      "description": "Schema-only mirror of [`katalogr_model::Span`].",
      "properties": {
        "end_col": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "end_line": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "start_col": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "start_line": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "start_line",
        "start_col",
        "end_line",
        "end_col"
      ],
      "type": "object"
    },
    "SymbolHit": {
      "properties": {
        "kind": {
          "type": "string"
        },
        "name": {
          "description": "Canonical name.",
          "type": "string"
        },
        "path": {
          "description": "Repository-relative path.",
          "type": "string"
        },
        "span": {
          "$ref": "#/$defs/Span"
        }
      },
      "required": [
        "name",
        "kind",
        "path",
        "span"
      ],
      "type": "object"
    },
    "TermTrace": {
      "properties": {
        "exact_postings": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "idf": {
          "description": "Rounded to 6 decimals.",
          "format": "double",
          "type": "number"
        },
        "matching_docs": {
          "description": "Documents matched by the token or any of its expansions.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "prefix": {
          "$ref": "#/$defs/PrefixTrace"
        },
        "token": {
          "type": "string"
        }
      },
      "required": [
        "token",
        "exact_postings",
        "matching_docs",
        "idf",
        "prefix"
      ],
      "type": "object"
    },
    "Trace": {
      "description": "What `--diagnostic` reports.",
      "properties": {
        "folds": {
          "description": "`refs`: the folds of the answer, in answer order, at most `DIAG_REFS` (the rest are\ncounted in `omitted[\"folds\"]`).",
          "items": {
            "$ref": "#/$defs/FoldTrace"
          },
          "type": "array"
        },
        "omitted": {
          "additionalProperties": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "description": "List name to the number of entries cut by a cap.",
          "type": "object"
        },
        "packing": {
          "anyOf": [
            {
              "$ref": "#/$defs/PackTrace"
            },
            {
              "type": "null"
            }
          ],
          "description": "Set by the wrapper that packs the output (`--budget`)."
        },
        "rank_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/RankSource"
            },
            {
              "type": "null"
            }
          ],
          "description": "`map`: where the rank came from."
        },
        "ranking": {
          "description": "`search`: the top hits, best first.",
          "items": {
            "$ref": "#/$defs/RankTrace"
          },
          "type": "array"
        },
        "routing": {
          "anyOf": [
            {
              "$ref": "#/$defs/RoutingTrace"
            },
            {
              "type": "null"
            }
          ]
        },
        "terms": {
          "description": "`search`: one per query token, in query order.",
          "items": {
            "$ref": "#/$defs/TermTrace"
          },
          "type": "array"
        },
        "weights": {
          "description": "`refs` and `map`: link weights.",
          "items": {
            "$ref": "#/$defs/WeightTrace"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Truncation": {
      "properties": {
        "budget": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "omitted": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "shown": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "shown",
        "omitted",
        "budget"
      ],
      "type": "object"
    },
    "WeightTrace": {
      "properties": {
        "confidence": {
          "description": "`Extracted`, `Inferred` or `Declared`.",
          "type": "string"
        },
        "fanout": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "from": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "to": {
          "description": "The symbol the link arrives at.",
          "type": "string"
        },
        "weight": {
          "description": "The link row's weight (6 decimals).",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "to",
        "from",
        "kind",
        "confidence",
        "weight"
      ],
      "type": "object"
    },
    "WorkingSetSummary": {
      "description": "What the answer says about the working set, so a reader can see why the order differs.",
      "properties": {
        "branch": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "dirty": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "item": {
          "description": "The active item, when there is one. Filled by the caller; [`WorkingSet::counts`] leaves\nit empty.",
          "type": [
            "string",
            "null"
          ]
        },
        "item_paths": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "recent": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "dirty",
        "recent",
        "branch",
        "item_paths"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "What `--json` prints.",
  "properties": {
    "context": {
      "description": "The context the answer was read from, when it names one.",
      "type": [
        "string",
        "null"
      ]
    },
    "diagnostic": {
      "anyOf": [
        {
          "$ref": "#/$defs/Trace"
        },
        {
          "type": "null"
        }
      ],
      "description": "The trace of the query, present only with `--diagnostic` (FEAT-065)."
    },
    "exact": {
      "default": false,
      "description": "Nothing was pending and every checkout's position was the same before and after the read.",
      "type": "boolean"
    },
    "folded": {
      "description": "`refs` and `callers` only: hits folded into summaries (absent with `--expand` and\nwhenever nothing was folded).",
      "items": {
        "$ref": "#/$defs/Fold"
      },
      "type": "array"
    },
    "next": {
      "description": "Suggested follow-up commands, at most three.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "partial": {
      "description": "Present when a cap or budget cut the answer; one entry per cap that cut it.",
      "items": {
        "$ref": "#/$defs/Partial"
      },
      "type": "array"
    },
    "pending": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "positions": {
      "description": "What the index reflects, one entry per repo sorted by repo (FEAT-084). Omitted when empty.",
      "items": {
        "$ref": "#/$defs/PositionRef"
      },
      "type": "array"
    },
    "result": {
      "$ref": "#/$defs/LineageReport"
    },
    "schema": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "stale": {
      "type": "boolean"
    },
    "truncated": {
      "anyOf": [
        {
          "$ref": "#/$defs/Truncation"
        },
        {
          "type": "null"
        }
      ]
    },
    "view_id": {
      "description": "Identifies this answer; present only on an exact answer to a question that has one.",
      "type": [
        "string",
        "null"
      ]
    },
    "watermark": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "working_set": {
      "anyOf": [
        {
          "$ref": "#/$defs/WorkingSetSummary"
        },
        {
          "type": "null"
        }
      ],
      "description": "`search` and `map` only (FEAT-039): the working set that reordered this answer. Absent\nwhen ranking was neutral or the set was empty."
    }
  },
  "required": [
    "schema",
    "watermark",
    "pending",
    "stale",
    "result"
  ],
  "title": "Envelope",
  "type": "object"
}
