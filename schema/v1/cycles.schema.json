{
  "$defs": {
    "Confidence": {
      "description": "Schema-only mirror of [`katalogr_model::Confidence`].",
      "enum": [
        "Extracted",
        "Inferred",
        "Declared"
      ],
      "type": "string"
    },
    "Confidence2": {
      "description": "Schema-only mirror of [`katalogr_model::Confidence`].",
      "enum": [
        "Extracted",
        "Inferred",
        "Declared"
      ],
      "type": "string"
    },
    "Cycle": {
      "properties": {
        "confidence": {
          "$ref": "#/$defs/Confidence2",
          "description": "The weakest confidence on the witness."
        },
        "id": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "members": {
          "items": {
            "$ref": "#/$defs/NodeHit"
          },
          "type": "array"
        },
        "members_total": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "size": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "witness": {
          "description": "One shortest cycle through the first member by name.",
          "items": {
            "$ref": "#/$defs/PathStep"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "size",
        "members",
        "members_total",
        "witness",
        "confidence"
      ],
      "type": "object"
    },
    "CycleReport": {
      "properties": {
        "cycles_total": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "cyclic_nodes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "include_inferred": {
          "type": "boolean"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/Cycle"
          },
          "type": "array"
        },
        "level": {
          "$ref": "#/$defs/Level"
        },
        "skipped_contracts": {
          "description": "Contracts with too many consumer and provider pairs to derive edges from.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "level",
        "include_inferred",
        "cycles_total",
        "cyclic_nodes",
        "skipped_contracts",
        "items"
      ],
      "type": "object"
    },
    "Direction": {
      "description": "Which way a link was followed.",
      "oneOf": [
        {
          "const": "Forward",
          "description": "The link points from `from` to `to`.",
          "type": "string"
        },
        {
          "const": "Backward",
          "description": "The link points from `to` to `from`.",
          "type": "string"
        }
      ]
    },
    "Level": {
      "description": "The granularity at which nodes are grouped.",
      "enum": [
        "symbol",
        "file",
        "package"
      ],
      "type": "string"
    },
    "NodeHit": {
      "description": "A node of the insight graph at some [`Level`].\n\nSymbol: canonical name, symbol kind, path, start line. File: artifact canonical name,\n`artifact`, path, no line. Package: the package fact value, `package`, the longest common\ndirectory of its files when they share a repository (else none), no line.",
      "properties": {
        "kind": {
          "type": "string"
        },
        "level": {
          "$ref": "#/$defs/Level"
        },
        "line": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "level",
        "name",
        "kind"
      ],
      "type": "object"
    },
    "PathStep": {
      "properties": {
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "direction": {
          "$ref": "#/$defs/Direction"
        },
        "from": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      },
      "required": [
        "from",
        "kind",
        "direction",
        "to",
        "confidence"
      ],
      "type": "object"
    },
    "Truncation": {
      "properties": {
        "budget": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "omitted": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "shown": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "shown",
        "omitted",
        "budget"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "What `--json` prints.",
  "properties": {
    "next": {
      "description": "Suggested follow-up commands, at most three.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "pending": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "result": {
      "$ref": "#/$defs/CycleReport"
    },
    "schema": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "stale": {
      "type": "boolean"
    },
    "truncated": {
      "anyOf": [
        {
          "$ref": "#/$defs/Truncation"
        },
        {
          "type": "null"
        }
      ]
    },
    "watermark": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema",
    "watermark",
    "pending",
    "stale",
    "result"
  ],
  "title": "Envelope",
  "type": "object"
}
