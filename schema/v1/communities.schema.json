{
  "$defs": {
    "Community": {
      "properties": {
        "boundary_weight": {
          "format": "double",
          "type": "number"
        },
        "bridges": {
          "items": {
            "$ref": "#/$defs/NodeHit"
          },
          "type": "array"
        },
        "cohesion": {
          "description": "Internal weight over internal plus boundary weight, 3 decimal places.",
          "format": "double",
          "type": "number"
        },
        "dir": {
          "description": "Longest common directory of the members' paths.",
          "type": [
            "string",
            "null"
          ]
        },
        "files": {
          "description": "Distinct files among the members.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "internal_weight": {
          "format": "double",
          "type": "number"
        },
        "label": {
          "$ref": "#/$defs/NodeHit"
        },
        "size": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "top": {
          "items": {
            "$ref": "#/$defs/NodeHit"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "size",
        "label",
        "cohesion",
        "internal_weight",
        "boundary_weight",
        "top",
        "bridges",
        "files"
      ],
      "type": "object"
    },
    "CommunityReport": {
      "properties": {
        "communities_total": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/Community"
          },
          "type": "array"
        },
        "level": {
          "$ref": "#/$defs/Level"
        },
        "modularity": {
          "description": "Modularity of the partition, 4 decimal places.",
          "format": "double",
          "type": "number"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "resolution": {
          "format": "double",
          "type": "number"
        },
        "seed": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "unclustered": {
          "description": "Nodes in no reported community (isolated, or in one below the minimum size).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "level",
        "seed",
        "resolution",
        "modularity",
        "communities_total",
        "unclustered",
        "items"
      ],
      "type": "object"
    },
    "Level": {
      "description": "The granularity at which nodes are grouped.",
      "enum": [
        "symbol",
        "file",
        "package"
      ],
      "type": "string"
    },
    "NodeHit": {
      "description": "A node of the insight graph at some [`Level`].\n\nSymbol: canonical name, symbol kind, path, start line. File: artifact canonical name,\n`artifact`, path, no line. Package: the package fact value, `package`, the longest common\ndirectory of its files when they share a repository (else none), no line.",
      "properties": {
        "kind": {
          "type": "string"
        },
        "level": {
          "$ref": "#/$defs/Level"
        },
        "line": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "level",
        "name",
        "kind"
      ],
      "type": "object"
    },
    "Partial": {
      "description": "The answer was cut by a cap: more items exist (or may exist) than are shown.",
      "properties": {
        "at": {
          "description": "The cap's value: N in \"capped at N\" (items, hops, or tokens for `budget`).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "cap": {
          "description": "Which cap: one of [`cap`]'s names.",
          "type": "string"
        },
        "note": {
          "description": "Always [`PARTIAL_NOTE`].",
          "type": "string"
        },
        "shown": {
          "description": "Items shown.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "description": "Items there were before the cap, when known.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "cap",
        "at",
        "shown",
        "note"
      ],
      "type": "object"
    },
    "Truncation": {
      "properties": {
        "budget": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "omitted": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "shown": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "shown",
        "omitted",
        "budget"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "What `--json` prints.",
  "properties": {
    "next": {
      "description": "Suggested follow-up commands, at most three.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "partial": {
      "description": "Present when a cap or budget cut the answer; one entry per cap that cut it.",
      "items": {
        "$ref": "#/$defs/Partial"
      },
      "type": "array"
    },
    "pending": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "result": {
      "$ref": "#/$defs/CommunityReport"
    },
    "schema": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "stale": {
      "type": "boolean"
    },
    "truncated": {
      "anyOf": [
        {
          "$ref": "#/$defs/Truncation"
        },
        {
          "type": "null"
        }
      ]
    },
    "watermark": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema",
    "watermark",
    "pending",
    "stale",
    "result"
  ],
  "title": "Envelope",
  "type": "object"
}
