{
  "$defs": {
    "PeerState": {
      "description": "One named peer: whether it could be read, and the positions its answers reflect.",
      "properties": {
        "fix": {
          "description": "The command that fixes it; never a path.",
          "type": [
            "string",
            "null"
          ]
        },
        "kindex": {
          "description": "The kindex alias, when the peer lives in another kindex.",
          "type": [
            "string",
            "null"
          ]
        },
        "positions": {
          "items": {
            "$ref": "#/$defs/PositionRef"
          },
          "type": "array"
        },
        "project": {
          "type": "string"
        },
        "repos_absent": {
          "description": "Repos in the peer's config with no recorded position here.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "stale": {
          "type": "boolean"
        },
        "state": {
          "description": "`ok`, `no-location`, `not-found`, `newer-format`, `no-index`, `unavailable` or `timeout`.",
          "type": "string"
        }
      },
      "required": [
        "project",
        "state",
        "positions",
        "stale"
      ],
      "type": "object"
    },
    "PositionRef": {
      "description": "One repo's position. Serialises as `{\"repo\",\"commit\",\"dirty\"}`, absent parts as `null`.",
      "properties": {
        "commit": {
          "description": "40 lower-case hex, or `None` for a directory with no commit.",
          "type": [
            "string",
            "null"
          ]
        },
        "dirty": {
          "description": "64 lower-case hex, or `None` when the checkout is clean.",
          "type": [
            "string",
            "null"
          ]
        },
        "repo": {
          "type": "string"
        }
      },
      "required": [
        "repo"
      ],
      "type": "object"
    },
    "ViewQueryJson": {
      "description": "The question a view answers, with every default filled in. `op` is the view's op (for\nexample `structure`), not the op of its view ID.",
      "properties": {
        "args": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "op": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "args"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A view at a position: Mermaid and the graph it was drawn from. Fields serialise in the\norder declared; the `None` fields are left out.",
  "properties": {
    "exact": {
      "type": "boolean"
    },
    "graph": {
      "description": "The view graph of the renderers."
    },
    "mermaid": {
      "type": "string"
    },
    "peers": {
      "description": "The peers the view read and the positions it reflects of each (FEAT-020). Left out when the\nview read none, so a view of a project with no peers keeps its exact bytes.",
      "items": {
        "$ref": "#/$defs/PeerState"
      },
      "type": "array"
    },
    "pele": {
      "description": "The Pele version the Mermaid was checked with.",
      "type": "string"
    },
    "pending": {
      "description": "Only when not exact.",
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "positions": {
      "description": "What the answer reflects, one entry per repo sorted by repo.",
      "items": {
        "$ref": "#/$defs/PositionRef"
      },
      "type": "array"
    },
    "query": {
      "$ref": "#/$defs/ViewQueryJson",
      "description": "The op and arguments, with defaults filled."
    },
    "schema": {
      "description": "`RESULT_SCHEMA_VERSION`.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "stale": {
      "description": "Only when not exact.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "view_format": {
      "description": "The view-ID format (chain decision CD-3).",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "view_id": {
      "description": "Only when exact.",
      "type": [
        "string",
        "null"
      ]
    },
    "watermark": {
      "description": "Only when not exact.",
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "required": [
    "schema",
    "view_format",
    "exact",
    "positions",
    "query",
    "mermaid",
    "graph",
    "pele"
  ],
  "title": "ViewAnswer",
  "type": "object"
}
