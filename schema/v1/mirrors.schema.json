{
  "$defs": {
    "FieldDiff": {
      "description": "One difference between two copies of a field.",
      "properties": {
        "field": {
          "description": "Normalised field path, `a/b` for nested fields.",
          "type": "string"
        },
        "left": {
          "anyOf": [
            {
              "$ref": "#/$defs/FieldShape"
            },
            {
              "type": "null"
            }
          ]
        },
        "right": {
          "anyOf": [
            {
              "$ref": "#/$defs/FieldShape"
            },
            {
              "type": "null"
            }
          ]
        },
        "what": {
          "description": "`missing-left`, `missing-right`, `type`, `required` or `many`.",
          "type": "string"
        }
      },
      "required": [
        "field",
        "what"
      ],
      "type": "object"
    },
    "FieldShape": {
      "description": "The structural facts of one field of a type that is declared more than once.",
      "properties": {
        "field_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "many": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "required": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "MirrorDrift": {
      "description": "Two declarers of one contract and how their fields differ.",
      "properties": {
        "comparable": {
          "description": "False when either side has no structural fields; then `differences` is empty.",
          "type": "boolean"
        },
        "contract": {
          "description": "`contract:<kind>:<key>`.",
          "type": "string"
        },
        "differences": {
          "items": {
            "$ref": "#/$defs/FieldDiff"
          },
          "type": "array"
        },
        "left": {
          "$ref": "#/$defs/SymbolHit",
          "description": "The reference declarer: the first by canonical name."
        },
        "right": {
          "$ref": "#/$defs/SymbolHit"
        }
      },
      "required": [
        "contract",
        "left",
        "right",
        "comparable",
        "differences"
      ],
      "type": "object"
    },
    "Span": {
      "description": "Schema-only mirror of [`katalogr_model::Span`].",
      "properties": {
        "end_col": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "end_line": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "start_col": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "start_line": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "start_line",
        "start_col",
        "end_line",
        "end_col"
      ],
      "type": "object"
    },
    "SymbolHit": {
      "properties": {
        "kind": {
          "type": "string"
        },
        "name": {
          "description": "Canonical name.",
          "type": "string"
        },
        "path": {
          "description": "Repository-relative path.",
          "type": "string"
        },
        "span": {
          "$ref": "#/$defs/Span"
        }
      },
      "required": [
        "name",
        "kind",
        "path",
        "span"
      ],
      "type": "object"
    },
    "Truncation": {
      "properties": {
        "budget": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "omitted": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "shown": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "shown",
        "omitted",
        "budget"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "What `--json` prints.",
  "properties": {
    "next": {
      "description": "Suggested follow-up commands, at most three.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "pending": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "result": {
      "items": {
        "$ref": "#/$defs/MirrorDrift"
      },
      "type": "array"
    },
    "schema": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "stale": {
      "type": "boolean"
    },
    "truncated": {
      "anyOf": [
        {
          "$ref": "#/$defs/Truncation"
        },
        {
          "type": "null"
        }
      ]
    },
    "watermark": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema",
    "watermark",
    "pending",
    "stale",
    "result"
  ],
  "title": "Envelope",
  "type": "object"
}
